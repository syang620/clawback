    "babel-preset-expo": "~57.0.3",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.0",
    "jest": "29.7.0",
    "jest-expo": "~57.0.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
