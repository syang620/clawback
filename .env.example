# Leave both values blank to run the credential-free local demo mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase Edge Function configuration. Never use EXPO_PUBLIC_.
AI_EXTRACTION_PROVIDER=
AI_EXTRACTION_ALLOWED_ORIGINS=
AI_EXTRACTION_TIMEOUT_MS=60000
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.6
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EXTRACTION_MODEL=qwen3.5:9b
